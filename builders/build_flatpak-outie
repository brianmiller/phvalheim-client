#!/bin/bash
# Linux .flatpak build, host side. Pass -b to answer "yes" to all questions.
#
# Produces builds/phvalheim-client-<version>-x86_64.flatpak, a single-file
# bundle that installs with:
#
#   flatpak install --user ./phvalheim-client-<version>-x86_64.flatpak
#
# Nothing needs to be installed on the host but Docker: flatpak, flatpak-builder
# and the whole test rig live in the container.
#
# FLATPAK_SKIP_RUNTIME_TESTS=1 skips the install/URL-handler/launch tests for
# fast iteration on the manifest. Never do that for a build you hand over.

# define our roots
scriptRoot=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)
gitRoot=$(echo $scriptRoot/|rev|cut -d "/" -f3-|rev)


# find docker
docker=$(which docker 2> /dev/null)
if [ $? = 0 ]; then
	docker=$docker
else
	podman=$(which podman 2> /dev/null)
	if [  $? = 0 ]; then
		docker=$podman
	else
		echo "ERROR: Docker or Podman are required, exiting..."
		exit 1
	fi
fi


echo
echo "Docker found at: $docker"
echo


# no TTY when this runs from CI or an agent session
tty=""
if [ -t 0 ]; then
	tty="-ti"
fi


echo "Building flatpak docker environment..."
echo
$docker build -t phvalheim-flatpak-env "$gitRoot/builders/dockers/flatpak/" || exit 1


echo
echo "Pulling .NET 9 SDK environment..."
echo
$docker image pull mcr.microsoft.com/dotnet/sdk:9.0 || exit 1


# stage 1: publish the linux-x64 binary with the .NET SDK
echo
echo "Publishing Linux binary inside container..."
echo
$docker run --rm -v "$gitRoot":'/git' $tty \
	-e DOTNET_CLI_TELEMETRY_OPTOUT=1 \
	-e DOTNET_NOLOGO=1 \
	mcr.microsoft.com/dotnet/sdk:9.0 /git/builders/build_flatpak-innie --publish || exit 1


# The org.freedesktop runtime and SDK are about 1.5 GB. Cache the flatpak
# installation so it is downloaded once rather than once per build.
#
# A named Docker volume, not a bind mount: the container runs as root and
# flatpak stores an ostree repo with its own ownership and hardlink layout in
# here. Handing it a host directory owned by the calling user causes flatpak
# to refuse the installation outright.
flatpakCache="phvalheim-flatpak-cache"
$docker volume create "$flatpakCache" >/dev/null || exit 1


# stage 2: package with flatpak-builder, then verify and test.
#
# --privileged is not optional. flatpak does every build step and every app
# launch inside bubblewrap, which needs user namespaces, mount and pid
# privileges that a default container does not have. Without it the build dies
# at the first sandbox setup.
#
# /dev/fuse and a large /dev/shm are for the same reason: flatpak-builder uses
# rofiles-fuse (disabled in the innie, but the runtime install still wants
# fuse) and the browser used in the URL-handler test needs shared memory.
echo
echo "Building flatpak inside container..."
echo
$docker run --rm -v "$gitRoot":'/git' $tty \
	--privileged \
	--device /dev/fuse \
	--shm-size=1g \
	-v "$flatpakCache":/var/lib/flatpak \
	-e FLATPAK_SKIP_RUNTIME_TESTS="${FLATPAK_SKIP_RUNTIME_TESTS:-0}" \
	phvalheim-flatpak-env /git/builders/build_flatpak-innie --package || exit 1


# containers write as root
echo
echo "Fixing ownership..."
sudo chown -R $(id -u):$(id -g) "$gitRoot/builds" "$gitRoot/bin" "$gitRoot/obj" 2>/dev/null
sudo rm -rf "$gitRoot/builders/.flatpak_staging" 2>/dev/null


echo
echo -n "Would you like to commit to GitHub? y/n "
if [ "$1" = "-b" ]; then
	gitCommit="y"
else
	read gitCommit
fi


if [ "$gitCommit" = "y" ] || [ "$gitCommit" = "Y" ]; then
	echo "Commiting to Git..."
	cd $gitRoot
	git add builds/*
	git commit -m "Automated Linux flatpak build"
	git push
else
	exit 0
fi

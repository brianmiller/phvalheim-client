#!/bin/bash
# Package the same signed universal payload as the macOS tarball.
# Avoid separately compiling an arm64-only URL handler or unsigned .NET apphost.
set -euo pipefail
repo=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
version=$(sed -n 's|.*<Version>\(.*\)</Version>.*|\1|p' "$repo/phvalheim-client.csproj" | head -1)
[ -n "$version" ]
if [ "${1:-}" != "--package" ]; then
    bash "$repo/builders/build_macos-innie"
fi
tarball="$repo/builds/phvalheim-client-$version-macos-universal.tar.gz"
[ -s "$tarball" ]
staging=$(mktemp -d)
trap 'rm -rf "$staging"' EXIT
mkdir -p "$staging/payload" "$staging/root/usr/local/bin" "$staging/root/Applications" "$staging/scripts"
tar -xzf "$tarball" -C "$staging/payload"
cp "$staging/payload/phvalheim-client" "$staging/root/usr/local/bin/"
cp -R "$staging/payload/PhValheim Client.app" "$staging/root/Applications/"
chmod 755 "$staging/root/usr/local/bin/phvalheim-client"
for binary in "$staging/root/usr/local/bin/phvalheim-client" "$staging/root/Applications/PhValheim Client.app/Contents/MacOS/PhValheim Client"; do
    archs=$(lipo -archs "$binary")
    [[ "$archs" == *x86_64* && "$archs" == *arm64* ]]
    codesign --verify --strict "$binary"
done
codesign --verify --deep --strict "$staging/root/Applications/PhValheim Client.app"
cat > "$staging/scripts/postinstall" <<'SCRIPT'
#!/bin/bash
set -e
# Installer scripts run as root. Register in the active desktop user's
# Launch Services database, not root's; headless installs register at login.
console_user=$(/usr/bin/stat -f %Su /dev/console)
if [ "$console_user" != root ] && [ "$console_user" != loginwindow ] && [ -n "$console_user" ]; then
    console_uid=$(/usr/bin/id -u "$console_user")
    /bin/launchctl asuser "$console_uid" /usr/bin/sudo -H -u "$console_user" \
        /System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister \
        -f "/Applications/PhValheim Client.app"
fi
SCRIPT
chmod 755 "$staging/scripts/postinstall"
pkgbuild --root "$staging/root" --scripts "$staging/scripts" \
    --identifier com.phospher.phvalheim-client --version "$version" \
    --install-location / "$staging/component.pkg"
productbuild --package "$staging/component.pkg" \
    "$repo/builds/phvalheim-client-$version-macos-universal.pkg"

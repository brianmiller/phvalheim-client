#!/bin/bash
# Windows .msi build, host side. Pass -b to answer "yes" to all questions.
#
# Replaces the Visual Studio Setup Project (.vdproj), which could only be built
# interactively on Windows. This runs headless on Linux.
#
# Signing is opt-in. Point CODESIGN_PFX at a .pfx outside the repo and set
# CODESIGN_PFX_PW or CODESIGN_PFX_PW_FILE; unset means an unsigned MSI.
# dev_tools/gen-codesign-cert.sh will mint a self-signed one.

# define our roots
scriptRoot=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)
gitRoot=$(echo $scriptRoot/|rev|cut -d "/" -f3-|rev)


# find docker
docker=$(which docker 2> /dev/null)
if [ $? = 0 ]; then
	docker=$docker
else
	podman=$(which podman 2> /dev/null)
	if [  $? = 0 ]; then
		docker=$podman
	else
		echo "ERROR: Docker or Podman are required, exiting..."
		exit 1
	fi
fi


echo
echo "Docker found at: $docker"
echo


# no TTY when this runs from CI or an agent session
tty=""
if [ -t 0 ]; then
	tty="-ti"
fi


# build the msi environment (wixl + wine + osslsigncode). Local build, not a
# pulled image: it is small and the Dockerfile is only a handful of apt lines.
echo "Building msi docker environment..."
echo
$docker build -t phvalheim-msi-env "$gitRoot/builders/dockers/windows/" || exit 1


echo
echo "Pulling .NET 9 SDK environment..."
echo
$docker image pull mcr.microsoft.com/dotnet/sdk:9.0 || exit 1


# stage 1: publish the win-x64 exe with the .NET SDK
echo
echo "Publishing Windows exe inside container..."
echo
$docker run --rm -v "$gitRoot":'/git' $tty \
	-e DOTNET_CLI_TELEMETRY_OPTOUT=1 \
	-e DOTNET_NOLOGO=1 \
	mcr.microsoft.com/dotnet/sdk:9.0 /git/builders/build_msi-innie --publish || exit 1


# stage 2: package it into an MSI with wixl, then sign and verify
echo
echo "Building msi inside container..."
echo
signArgs=()
if [ -n "${CODESIGN_PFX:-}" ]; then
	# mount the key material read-only, from wherever it lives outside the repo
	pfxDir=$(cd -- "$(dirname -- "$CODESIGN_PFX")" &>/dev/null && pwd)
	pfxName=$(basename "$CODESIGN_PFX")
	signArgs+=(-v "$pfxDir":/codesign:ro -e CODESIGN_PFX="/codesign/$pfxName")
	if [ -n "${CODESIGN_PFX_PW:-}" ]; then
		signArgs+=(-e CODESIGN_PFX_PW="$CODESIGN_PFX_PW")
	elif [ -n "${CODESIGN_PFX_PW_FILE:-}" ]; then
		signArgs+=(-e CODESIGN_PFX_PW_FILE="/codesign/$(basename "$CODESIGN_PFX_PW_FILE")")
	fi
fi

$docker run --rm -v "$gitRoot":'/git' $tty "${signArgs[@]}" \
	phvalheim-msi-env /git/builders/build_msi-innie --package || exit 1


# containers write as root
echo
echo "Fixing ownership..."
sudo chown -R $(id -u):$(id -g) "$gitRoot/builds" "$gitRoot/bin" "$gitRoot/obj" 2>/dev/null
rm -rf "$gitRoot/builders/.msi_staging"


echo
echo -n "Would you like to commit to GitHub? y/n "
if [ "$1" = "-b" ]; then
	gitCommit="y"
else
	read gitCommit
fi


if [ "$gitCommit" = "y" ] || [ "$gitCommit" = "Y" ]; then
	echo "Commiting to Git..."
	cd $gitRoot
	git add builds/*
	git commit -m "Automated Windows msi build"
	git push
else
	exit 0
fi

#!/bin/bash
#
# Windows .msi build, container side. Runs in two stages because no single
# image has both the .NET 9 SDK and wixl:
#
#   --publish   in mcr.microsoft.com/dotnet/sdk:9.0   -> win-x64 single-file exe
#   --package   in the builders/dockers/windows image -> wixl, sign, verify
#
# The outie drives both. Don't run this on the host.

set -u

stage="${1:-}"
gitRoot=/git
stagingDir="$gitRoot/builders/.msi_staging"

version=$(grep -m1 -oP '(?<=<Version>)[^<]+' "$gitRoot/phvalheim-client.csproj")
if [ -z "$version" ]; then
	echo "ERROR: could not read <Version> from phvalheim-client.csproj"
	exit 1
fi

case "$stage" in

--publish)
	echo
	echo "Publishing win-x64 single-file exe (version $version)..."
	echo

	# PostBuildEvent is cleared: it invokes builders/post_build_vss.bat, which is
	# Windows-only and would fail the build here.
	dotnet publish "$gitRoot/phvalheim-client.csproj" \
		-c Windows-Release \
		-r win-x64 \
		-p:PublishSingleFile=true \
		-p:PublishTrimmed=false \
		-p:PostBuildEvent= \
		--self-contained true \
		/consoleloggerparameters:NoSummary || exit 1

	exe="$gitRoot/bin/Windows-Release/net9.0/win-x64/publish/phvalheim-client.exe"
	if [ ! -s "$exe" ]; then
		echo "ERROR: publish produced no exe at $exe"
		exit 1
	fi

	# Confirm we actually built a Windows binary and not, say, an ELF with a
	# .exe name -- dotnet will happily emit the host RID's format if the RID
	# argument is dropped somewhere upstream.
	if [ "$(head -c2 "$exe")" != "MZ" ]; then
		echo "ERROR: $exe is not a PE executable (no MZ header)"
		exit 1
	fi
	echo "Published $(stat -c%s "$exe") bytes: $exe"
	;;

--package)
	echo
	echo "Building phvalheim-client-$version-x86_64.msi..."
	echo

	exe="$gitRoot/bin/Windows-Release/net9.0/win-x64/publish/phvalheim-client.exe"
	if [ ! -s "$exe" ]; then
		echo "ERROR: no published exe at $exe -- run the --publish stage first"
		exit 1
	fi

	rm -rf "$stagingDir"
	mkdir -p "$stagingDir"
	cp "$exe" "$stagingDir/phvalheim-client.exe" || exit 1
	cp "$gitRoot/phvalheim-client.ico" "$stagingDir/phvalheim-client.ico" || exit 1
	cp "$gitRoot/builders/wxs/phvalheim-client.wxs" "$stagingDir/" || exit 1
	# The wizard: dialog set + the .vdproj's banner bitmap it references.
	cp "$gitRoot/builders/wxs/ui-phvalheim.wxs" "$stagingDir/" || exit 1
	cp "$gitRoot/builders/wxs/banner.bmp"       "$stagingDir/" || exit 1

	# A literal double hyphen inside an XML comment is illegal, and both .wxs
	# files carry a lot of explanatory prose. libxml2 (which wixl uses) reports
	# it as "Extra content at the end of the document" pointing at a line
	# nowhere near the real fault. That has cost three build cycles, so name it
	# precisely before handing the file to wixl. xmllint is not in this image.
	if ! awk '
		{
			line = $0
			while (length(line)) {
				if (!inComment) {
					p = index(line, "<!--")
					if (p == 0) break
					inComment = 1
					line = substr(line, p + 4)
				} else {
					p = index(line, "-->")
					if (p == 0) { seg = line; line = "" }
					else { seg = substr(line, 1, p - 1); line = substr(line, p + 3); inComment = 0 }
					if (index(seg, "--")) {
						printf "       %s:%d: \"--\" inside an XML comment\n", FILENAME, FNR
						bad = 1
					}
				}
			}
		}
		END { exit bad ? 1 : 0 }
	' "$stagingDir"/*.wxs; then
		echo "ERROR: illegal double hyphen in an XML comment (see above)."
		echo "       libxml2 would report this as \"Extra content at the end of"
		echo "       the document\" on an unrelated line. Reword the comment."
		exit 1
	fi

	out="$gitRoot/builds/phvalheim-client-$version-x86_64.msi"
	mkdir -p "$gitRoot/builds"

	# -a x64 is what stamps the summary-info arch template. A Platform=
	# attribute in the .wxs is warned-and-ignored by wixl, so this flag is
	# load-bearing, not decorative.
	#
	# Both .wxs files go in together: ui-phvalheim.wxs defines the
	# WixUI_PhValheim dialog set that phvalheim-client.wxs pulls in by UIRef.
	# Drop it and the UIRef is unresolved, so the build fails loudly rather
	# than emitting a UI-less package -- which is how 2.0.13 first shipped.
	#
	# --ext ui is required even though we author every dialog ourselves: it is
	# what makes wixl create the Dialog/Control/ControlEvent tables at all.
	# Without it wixl prints "wixl_msi_table_control_add: assertion 'self !=
	# NULL' failed" for every control and still exits 0, emitting an MSI with
	# an empty UI. It does drag in the stock WixUI_Bmp_* binaries and CancelDlg
	# as dead weight; harmless, and nothing we author references them.
	( cd "$stagingDir" && wixl -a x64 --ext ui -D Version="$version" -o "$out" phvalheim-client.wxs ui-phvalheim.wxs ) || exit 1

	if [ ! -s "$out" ]; then
		echo "ERROR: wixl produced no output at $out"
		exit 1
	fi
	echo "Built $(stat -c%s "$out") bytes: $out"

	# Optional Authenticode signing. Same env var contract the retired
	# scripts/post.ps1 used, so nothing external has to change. Unsigned is a
	# normal, non-fatal outcome -- the Linux packages ship unsigned too.
	if [ -n "${CODESIGN_PFX:-}" ]; then
		if [ ! -s "$CODESIGN_PFX" ]; then
			echo "ERROR: CODESIGN_PFX is set but $CODESIGN_PFX is missing or empty"
			exit 1
		fi
		if [ -n "${CODESIGN_PFX_PW:-}" ]; then
			pw="$CODESIGN_PFX_PW"
		elif [ -n "${CODESIGN_PFX_PW_FILE:-}" ]; then
			pw=$(tr -d '\r\n' < "$CODESIGN_PFX_PW_FILE")
		else
			echo "ERROR: CODESIGN_PFX is set but neither CODESIGN_PFX_PW nor CODESIGN_PFX_PW_FILE is"
			exit 1
		fi

		echo "Signing with $CODESIGN_PFX..."
		# osslsigncode cannot sign in place.
		if osslsigncode sign \
			-pkcs12 "$CODESIGN_PFX" \
			-pass "$pw" \
			-n "PhValheim Client" \
			-i "https://github.com/brianmiller/phvalheim-client" \
			-h sha256 \
			-in "$out" \
			-out "$out.signed" > /tmp/ossl.log 2>&1
		then
			mv -f "$out.signed" "$out"
			echo "Signed."
		else
			echo "ERROR: signing failed:"
			tail -20 /tmp/ossl.log
			rm -f "$out.signed"
			exit 1
		fi
	else
		echo "CODESIGN_PFX unset -- leaving the MSI unsigned."
	fi

	# Linux MSI builds get no ICE validation. verify_msi.sh is the substitute
	# and its exit status gates the build.
	bash "$gitRoot/builders/verify_msi.sh" "$out" "$version" || exit 1

	# verify_msi.sh asserts what is IN the package. The matrix asserts what it
	# DOES: fresh install, uninstall, repair, upgrade over a predecessor, and
	# the wizard rendered on a virtual display. Every scenario in it exists
	# because a bug shipped past a fully green verify_msi.sh on 2026-09-11.
	#
	# It is slow (a wine prefix per scenario), so MSI_SKIP_MATRIX=1 exists for
	# fast iteration on the .wxs. NEVER skip it for a build you hand over --
	# the upgrade and wizard scenarios are the only automated coverage those
	# paths have ever had.
	if [ "${MSI_SKIP_MATRIX:-0}" = "1" ]; then
		echo
		echo "  SKIP  install matrix (MSI_SKIP_MATRIX=1). Not a release build."
	else
		# A predecessor to upgrade from. Built from this same source at a lower
		# version, because the real 2.0.12 will not install under wine.
		prevDir="$stagingDir/prev"
		mkdir -p "$prevDir"
		cp "$stagingDir"/*.wxs "$stagingDir/banner.bmp" "$stagingDir/phvalheim-client.ico" \
		   "$stagingDir/phvalheim-client.exe" "$prevDir/" 2>/dev/null
		prevVersion="${MSI_PREV_VERSION:-2.0.12}"
		( cd "$prevDir" && wixl -a x64 --ext ui -D Version="$prevVersion" \
			-o prev.msi phvalheim-client.wxs ui-phvalheim.wxs ) >/dev/null 2>&1

		shots="$gitRoot/builders/.msi_shots"
		rm -rf "$shots"; mkdir -p "$shots"
		matrixArgs=("$out" "$version" "--shots" "$shots")
		if [ -s "$prevDir/prev.msi" ]; then
			matrixArgs+=("--prev" "$prevDir/prev.msi")
		else
			echo "  WARN  could not build a $prevVersion predecessor; upgrade scenario will be skipped"
		fi
		python3 "$gitRoot/builders/test_install_matrix.py" "${matrixArgs[@]}" || exit 1
	fi

	rm -rf "$stagingDir"
	;;

*)
	echo "usage: build_msi-innie --publish | --package"
	exit 1
	;;
esac

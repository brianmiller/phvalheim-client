<?xml version="1.0" encoding="utf-8"?>
<!--
  WiX v3 source for the PhValheim Client Windows installer.

  Built headlessly on Linux by `wixl` (GNOME msitools), NOT by the WiX Toolset.
  WiX v4/v5 refuses to build on Linux ("WIX0000: The WiX Toolset only supports
  Windows"), so this file deliberately targets the WiX v3 schema that wixl parses.

  This replaces phvalheim-client-installer/phvalheim-client-installer.vdproj, a
  Visual Studio Setup Project that could only be built interactively on Windows.
  Everything below reproduces that project's shipped behaviour exactly.

  Build:  wixl -a x64 -D Version=<x.y.z> -o out.msi phvalheim-client.wxs
  Verify: builders/verify_msi.sh out.msi <x.y.z>
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">

  <!--
    UpgradeCode is inherited verbatim from the .vdproj. It MUST NOT change:
    it is the only thing tying a 2.0.13 install to the 2.0.12 (and earlier)
    installs it has to replace. A new UpgradeCode would leave every existing
    install on disk and register a second, parallel product.
  -->
  <Product Id="*"
           Name="PhValheim Client"
           Language="1033"
           Version="$(var.Version)"
           Manufacturer="Phospher"
           UpgradeCode="9799CDE9-1240-47AC-9891-AAB1F6FDB5E7">

    <Package InstallerVersion="200"
             Compressed="yes"
             InstallScope="perMachine"
             Description="PhValheim Client"
             Comments="PhValheim Client"
             Manufacturer="Phospher" />

    <Media Id="1" Cabinet="product.cab" EmbedCab="yes" />

    <!-- ARP ("Add/Remove Programs") metadata, matching the .vdproj -->
    <Icon Id="phvalheim.ico" SourceFile="phvalheim-client.ico" />
    <Property Id="ARPPRODUCTICON" Value="phvalheim.ico" />
    <Property Id="ARPCONTACT" Value="posixone" />

    <!--
      .vdproj had RemovePreviousVersions=TRUE + DetectNewerInstalledVersion=TRUE.
      This is the equivalent: uninstall-then-reinstall on upgrade, refuse to
      install over a newer version, and SAY SO when the same version is
      already present.

      Authored as a raw Upgrade element rather than MajorUpgrade because
      MajorUpgrade emits exactly two rows (older and newer) and there is no
      way to add a third. The same-version row is the one that matters here:
      with only the older/newer pair, a package whose version EQUALS the
      installed one matches neither range, so FindRelatedProducts finds
      nothing and Windows installs it as a second, parallel product. That is
      how two 2.0.13-era installs ended up side by side.

      Verified that wixl honours the raw form: a probe package built with this
      shape emits both the Upgrade table and the explicit
      RemoveExistingProducts row. Do not assume it; msiinfo export and look.
    -->
    <Upgrade Id="9799CDE9-1240-47AC-9891-AAB1F6FDB5E7">
      <!-- Anything older: migrate features and let RemoveExistingProducts take it. -->
      <UpgradeVersion Minimum="0.0.0" IncludeMinimum="yes"
                      Maximum="$(var.Version)" IncludeMaximum="no"
                      Property="PHV_OLDER_FOUND" MigrateFeatures="yes" />

      <!--
        Exactly this version, from a DIFFERENT package. OnlyDetect: never
        silently replace or duplicate it, just report it. This cannot fire for
        a rerun of the same .msi file, because FindRelatedProducts skips the
        running package's own ProductCode; that case is maintenance mode and
        MaintenanceForm handles it.
      -->
      <UpgradeVersion Minimum="$(var.Version)" IncludeMinimum="yes"
                      Maximum="$(var.Version)" IncludeMaximum="yes"
                      Property="PHV_SAME_VERSION_FOUND" OnlyDetect="yes" />

      <!-- Anything newer: detect only, refused by the LaunchCondition below. -->
      <UpgradeVersion Minimum="$(var.Version)" IncludeMinimum="no"
                      Property="PHV_NEWER_FOUND" OnlyDetect="yes" />
    </Upgrade>

    <!--
      MajorUpgrade scheduled this for us. Authoring the Upgrade table by hand
      means scheduling it by hand too, and forgetting it is silent: detection
      still sets the properties, nothing ever removes the old product.
      After InstallValidate is the early position, so the old files are gone
      before the new ones are laid down.
    -->
    <InstallExecuteSequence>
      <RemoveExistingProducts After="InstallValidate" />
    </InstallExecuteSequence>

    <!--
      LaunchConditions runs at sequence 100, FindRelatedProducts at 25, so
      both properties are set by the time these are evaluated.
    -->
    <Condition Message="A newer version of [ProductName] is already installed. Remove it first if you want to go back to this version.">NOT PHV_NEWER_FOUND</Condition>
    <Condition Message="[ProductName] [ProductVersion] is already installed on this computer. There is nothing to do. To repair or remove it, use Apps &amp; features, or run the installer you originally installed it with.">NOT PHV_SAME_VERSION_FOUND</Condition>

    <Directory Id="TARGETDIR" Name="SourceDir">

      <!--
        The payload lives in %AppData%\PhValheim\phvalheim-client\, NOT in
        Program Files. This is what the .vdproj shipped and what the registered
        phvalheim:// command line points at, so it cannot move without breaking
        both the URL handler and upgrades from 2.0.12.
      -->
      <Directory Id="AppDataFolder">
        <Directory Id="PhValheimDir" Name="PhValheim">
          <Directory Id="INSTALLFOLDER" Name="phvalheim-client">

            <Component Id="ClientExe" Guid="03C52D9D-65FD-467A-94CE-71EF091DEE75">
              <!-- DefaultVersion is load-bearing on UPGRADES. Publishing the
                   single-file exe on Linux leaves it with no Win32 version
                   resource, so wixl writes an EMPTY File.Version. MSI then
                   treats it as unversioned, and an unversioned incoming file
                   never overwrites a versioned existing one: costing decides
                   to skip it while 2.0.12 is still installed, then
                   RemoveExistingProducts deletes 2.0.12's copy, and the
                   machine is left with no exe at all. 2.0.12 shipped
                   ver=2.0.12.0 because it was built on Windows. -->
              <File Id="clientExe"
                    Name="phvalheim-client.exe"
                    Source="phvalheim-client.exe"
                    DefaultVersion="$(var.Version).0"
                    KeyPath="yes" />
            </Component>

            <Component Id="ClientIco" Guid="B0106DCD-8A66-47DA-8974-A8E780BBE8F7">
              <File Id="clientIco"
                    Name="phvalheim-client.ico"
                    Source="phvalheim-client.ico"
                    KeyPath="yes" />
            </Component>

          </Directory>
        </Directory>
      </Directory>

      <!--
        The phvalheim:// URL scheme. This is the whole reason the installer
        exists: the server hands out phvalheim:// links and Windows needs to
        know which binary opens them.

        The command value is REG_EXPAND_SZ (Type="expandable") because it
        contains %appdata% — as REG_SZ, Windows would hand the literal string
        "%appdata%\..." to CreateProcess and the handler would silently fail.
      -->
      <Component Id="UrlScheme" Guid="5C974DAC-CA30-4EF2-9660-76EEF207EB37">
        <RegistryKey Root="HKCR" Key="phvalheim">
          <RegistryValue Type="string" Value="PhValheim Client" />
          <RegistryValue Name="URL Protocol" Type="string" Value="" />
        </RegistryKey>
        <RegistryValue Root="HKCR"
                       Key="phvalheim\shell\open\command"
                       Type="expandable"
                       Value="&quot;%appdata%\PhValheim\phvalheim-client\phvalheim-client.exe&quot; &quot;%1&quot;"
                       KeyPath="yes" />
      </Component>

      <!--
        NOT reproduced from the .vdproj: two empty, valueless keys at
        HKLM\Software\Phospher and HKCU\Software\Phospher. Nothing writes them,
        nothing reads them (the client's only registry read is
        HKCU\Software\Valve\Steam, in Platform.cs), and they hold no values.
        They are vestigial, and 2.0.12's own uninstall removes its copies during
        the major upgrade, so dropping them orphans nothing. wixl also has no
        ForceCreateOnInstall support, so reproducing them would have required
        inventing a registry value this product has never had.
      -->

    </Directory>

    <Feature Id="Main" Level="1" Title="PhValheim Client">
      <ComponentRef Id="ClientExe" />
      <ComponentRef Id="ClientIco" />
      <ComponentRef Id="UrlScheme" />
    </Feature>

    <!--
      The wizard. 2.0.13's first build shipped with NO UI tables at all, which
      made a SUCCESSFUL install indistinguishable from a crash (msiexec showed
      "Gathering required information" and then vanished, with no completion
      page) and left a genuine failure equally silent, because the fatal-error
      dialog was missing too.

      The dialog set is builders/wxs/ui-phvalheim.wxs, a faithful re-authoring
      of the .vdproj wizard 2.0.12 shipped: banner style, the product's own
      text, and the .vdproj's own banner bitmap. Both .wxs files are passed to
      wixl together; see builders/build_msi-innie.

      Do NOT replace this with the stock wixl dialogs (the "ext ui" extension / WixUI_*).
      They are side-bitmap style over a solid maroon 493x312 image, and their
      body text is WiX boilerplate. That was tried and rejected.
    -->
    <UIRef Id="WixUI_PhValheim" />

  </Product>

</Wix>
